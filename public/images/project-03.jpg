<svg width="1600" height="900" viewBox="0 0 1600 900" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="1600" height="900" fill="#f8fafb"/>

  <!-- Gradient Background -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e8f5e9;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ffffff;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cardGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#2e7d32;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#43a047;stop-opacity:1" />
    </linearGradient>
    <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="0" dy="10" stdDeviation="20" flood-opacity="0.15"/>
    </filter>
    <filter id="phoneShadow" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="0" dy="30" stdDeviation="40" flood-opacity="0.2"/>
    </filter>
  </defs>

  <rect width="1600" height="900" fill="url(#bgGradient)"/>

  <!-- Left Side - Supporting Elements -->
  <!-- Decorative Circles -->
  <circle cx="150" cy="150" r="80" fill="#c8e6c9" opacity="0.3"/>
  <circle cx="200" cy="750" r="100" fill="#a5d6a7" opacity="0.25"/>
  <circle cx="1450" cy="200" r="120" fill="#c8e6c9" opacity="0.2"/>

  <!-- Mobile Phone Frame -->
  <g filter="url(#phoneShadow)">
    <!-- Phone Body -->
    <rect x="620" y="80" width="360" height="740" rx="30" fill="#1a1a1a"/>
    <rect x="635" y="95" width="330" height="710" rx="20" fill="#ffffff"/>

    <!-- Status Bar -->
    <text x="660" y="125" font-family="Arial, sans-serif" font-size="14" fill="#1a1a1a" font-weight="600">9:41</text>
    <rect x="890" y="112" width="25" height="12" rx="3" fill="#2e7d32"/>
    <rect x="920" y="110" width="20" height="16" rx="2" fill="none" stroke="#1a1a1a" stroke-width="2"/>
    <rect x="942" y="113" width="3" height="10" rx="1" fill="#1a1a1a"/>

    <!-- Header -->
    <text x="720" y="175" font-family="Arial, sans-serif" font-size="24" fill="#1a1a1a" font-weight="700" text-anchor="middle">My Account</text>

    <!-- Balance Card -->
    <g filter="url(#shadow)">
      <rect x="665" y="200" width="270" height="160" rx="16" fill="url(#cardGradient)"/>
      <text x="690" y="235" font-family="Arial, sans-serif" font-size="14" fill="#ffffff" opacity="0.9">Available Balance</text>
      <text x="690" y="280" font-family="Arial, sans-serif" font-size="38" fill="#ffffff" font-weight="700">$12,458.50</text>
      <text x="690" y="310" font-family="Arial, sans-serif" font-size="13" fill="#ffffff" opacity="0.8">Account: ****4892</text>

      <!-- Card Chip -->
      <rect x="690" y="325" width="35" height="28" rx="4" fill="#ffd54f" opacity="0.9"/>
      <rect x="693" y="328" width="29" height="22" rx="2" fill="none" stroke="#f9a825" stroke-width="1"/>
    </g>

    <!-- Quick Actions -->
    <text x="680" y="405" font-family="Arial, sans-serif" font-size="16" fill="#1a1a1a" font-weight="600">Quick Actions</text>

    <!-- Action Buttons -->
    <g>
      <!-- Send Money -->
      <rect x="670" y="420" width="70" height="70" rx="12" fill="#e8f5e9"/>
      <circle cx="705" cy="448" r="15" fill="#2e7d32"/>
      <path d="M 705 443 L 710 448 L 705 453 M 710 448 L 700 448" stroke="#ffffff" stroke-width="2" fill="none" stroke-linecap="round"/>
      <text x="705" y="480" font-family="Arial, sans-serif" font-size="11" fill="#1a1a1a" text-anchor="middle">Send</text>

      <!-- Request -->
      <rect x="755" y="420" width="70" height="70" rx="12" fill="#e8f5e9"/>
      <circle cx="790" cy="448" r="15" fill="#2e7d32"/>
      <path d="M 790 443 L 785 448 L 790 453 M 785 448 L 795 448" stroke="#ffffff" stroke-width="2" fill="none" stroke-linecap="round"/>
      <text x="790" y="480" font-family="Arial, sans-serif" font-size="11" fill="#1a1a1a" text-anchor="middle">Request</text>

      <!-- Pay Bills -->
      <rect x="840" y="420" width="70" height="70" rx="12" fill="#e8f5e9"/>
      <circle cx="875" cy="448" r="15" fill="#2e7d32"/>
      <rect x="869" y="442" width="12" height="12" rx="2" fill="none" stroke="#ffffff" stroke-width="2"/>
      <text x="875" y="480" font-family="Arial, sans-serif" font-size="11" fill="#1a1a1a" text-anchor="middle">Bills</text>
    </g>

    <!-- Recent Transactions -->
    <text x="680" y="535" font-family="Arial, sans-serif" font-size="16" fill="#1a1a1a" font-weight="600">Recent Transactions</text>

    <!-- Transaction Items -->
    <g>
      <!-- Transaction 1 -->
      <rect x="665" y="550" width="270" height="60" rx="10" fill="#f5f5f5"/>
      <circle cx="690" cy="580" r="18" fill="#2e7d32" opacity="0.15"/>
      <text x="690" y="585" font-family="Arial, sans-serif" font-size="16" fill="#2e7d32" text-anchor="middle">S</text>
      <text x="720" y="575" font-family="Arial, sans-serif" font-size="14" fill="#1a1a1a" font-weight="600">Starbucks</text>
      <text x="720" y="593" font-family="Arial, sans-serif" font-size="12" fill="#757575">Today, 9:23 AM</text>
      <text x="915" y="583" font-family="Arial, sans-serif" font-size="15" fill="#d32f2f" font-weight="600" text-anchor="end">-$5.40</text>

      <!-- Transaction 2 -->
      <rect x="665" y="620" width="270" height="60" rx="10" fill="#f5f5f5"/>
      <circle cx="690" cy="650" r="18" fill="#2e7d32" opacity="0.15"/>
      <text x="690" y="655" font-family="Arial, sans-serif" font-size="16" fill="#2e7d32" text-anchor="middle">A</text>
      <text x="720" y="645" font-family="Arial, sans-serif" font-size="14" fill="#1a1a1a" font-weight="600">Apple Store</text>
      <text x="720" y="663" font-family="Arial, sans-serif" font-size="12" fill="#757575">Yesterday, 2:15 PM</text>
      <text x="915" y="653" font-family="Arial, sans-serif" font-size="15" fill="#d32f2f" font-weight="600" text-anchor="end">-$129.99</text>

      <!-- Transaction 3 -->
      <rect x="665" y="690" width="270" height="60" rx="10" fill="#f5f5f5"/>
      <circle cx="690" cy="720" r="18" fill="#2e7d32" opacity="0.15"/>
      <text x="690" y="725" font-family="Arial, sans-serif" font-size="16" fill="#2e7d32" text-anchor="middle">P</text>
      <text x="720" y="715" font-family="Arial, sans-serif" font-size="14" fill="#1a1a1a" font-weight="600">Payroll Deposit</text>
      <text x="720" y="733" font-family="Arial, sans-serif" font-size="12" fill="#757575">Dec 1, 8:00 AM</text>
      <text x="915" y="723" font-family="Arial, sans-serif" font-size="15" fill="#2e7d32" font-weight="600" text-anchor="end">+$2,500.00</text>
    </g>

    <!-- Bottom Navigation Bar -->
    <rect x="635" y="770" width="330" height="35" fill="#ffffff"/>
    <line x1="680" y1="770" x2="680" y2="805" stroke="#e0e0e0" stroke-width="1"/>
    <line x1="760" y1="770" x2="760" y2="805" stroke="#e0e0e0" stroke-width="1"/>
    <line x1="840" y1="770" x2="840" y2="805" stroke="#e0e0e0" stroke-width="1"/>
    <line x1="920" y1="770" x2="920" y2="805" stroke="#e0e0e0" stroke-width="1"/>

    <!-- Nav Icons -->
    <circle cx="657" cy="787" r="8" fill="#2e7d32"/>
    <rect x="732" y="779" width="16" height="16" rx="2" fill="#bdbdbd"/>
    <circle cx="800" cy="787" r="8" fill="#bdbdbd"/>
    <rect x="872" y="779" width="16" height="16" rx="2" fill="#bdbdbd"/>
    <circle cx="948" cy="787" r="8" fill="#bdbdbd"/>
  </g>

  <!-- Right Side - Text Content -->
  <g>
    <text x="1050" y="280" font-family="Arial, sans-serif" font-size="42" fill="#1a1a1a" font-weight="700">
      <tspan x="1050" dy="0">Mobile Banking</tspan>
      <tspan x="1050" dy="50">Reimagined</tspan>
    </text>

    <text x="1050" y="390" font-family="Arial, sans-serif" font-size="18" fill="#616161" font-weight="400">
      <tspan x="1050" dy="0">Secure • Fast • Intuitive</tspan>
    </text>

    <!-- Features -->
    <g>
      <circle cx="1060" cy="450" r="5" fill="#2e7d32"/>
      <text x="1080" y="455" font-family="Arial, sans-serif" font-size="16" fill="#424242">Real-time balance tracking</text>

      <circle cx="1060" cy="485" r="5" fill="#2e7d32"/>
      <text x="1080" y="490" font-family="Arial, sans-serif" font-size="16" fill="#424242">Quick money transfers</text>

      <circle cx="1060" cy="520" r="5" fill="#2e7d32"/>
      <text x="1080" y="525" font-family="Arial, sans-serif" font-size="16" fill="#424242">Bill payment automation</text>

      <circle cx="1060" cy="555" r="5" fill="#2e7d32"/>
      <text x="1080" y="560" font-family="Arial, sans-serif" font-size="16" fill="#424242">Transaction history & insights</text>

      <circle cx="1060" cy="590" r="5" fill="#2e7d32"/>
      <text x="1080" y="595" font-family="Arial, sans-serif" font-size="16" fill="#424242">Bank-level security</text>
    </g>

    <!-- Tech Stack Badge -->
    <rect x="1050" y="640" width="200" height="40" rx="20" fill="#2e7d32" opacity="0.1"/>
    <text x="1150" y="666" font-family="Arial, sans-serif" font-size="14" fill="#2e7d32" font-weight="600" text-anchor="middle">iOS • Android • React Native</text>
  </g>

  <!-- Project Label -->
  <text x="80" y="850" font-family="Arial, sans-serif" font-size="16" fill="#9e9e9e" font-weight="500">PROJECT 03</text>
  <text x="1480" y="850" font-family="Arial, sans-serif" font-size="14" fill="#bdbdbd" font-weight="400" text-anchor="end">Kashavi Infotech</text>
</svg>